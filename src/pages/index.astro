---
import Layout from "../layouts/Layout.astro";
import { featuredProjects } from "../data/featuredProjects.js";

const featured = featuredProjects[Math.floor(Math.random() * featuredProjects.length)];
---

<Layout title="Amedeo Leproni">
  <header id="home" class="hero">
    <p class="kicker">Hwæt</p>
    <h1 class="title">Amedeo Leproni</h1>

    <p class="lede" style="font-style: italic; margin-bottom: 1.5rem;">
      Scientist and engineer, curious explorer, respectful steward.
    </p>

    <div class="contentNarrow">
      <figure class="heroImage">
        <img
          src="/docs/me.webp"
          alt="Amedeo Leproni"
          width="1200"
          height="900"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </header>

  <section aria-label="About" class="section reveal">
    <h2 class="sectionTitle">About.</h2>
    <p>
      <strong>Currently</strong> Founder in Residence at Entrepreneurs First, building rapid microbial contamination tests
      that unlock inventory liquidity for the food and beverage, pharmaceutical, and cosmetics industries.
    </p>
    <p>
      Previously...
      <br />I <strong>built</strong> a phenotyping platform to study plant–parasite interactions, and a forearm bioelectronic
      signal acquisition system to classify hand gestures using machine learning.
    </p>
    <p>
      I <strong>led</strong> a Cambridge University MPhil consulting project for AstraZeneca, defining the architecture of a
      wearable cytokine release syndrome monitoring system to support early outpatient clearance following oncology clinical
      trials.
    </p>
    <p>
      I <strong>founded</strong> a soup kitchen welcoming homeless guests to shared dinners to combat isolation, served as an
      equestrian guide and ranch hand in Argentina, Uruguay, and Romania, and speak four languages fluently.
    </p>
  </section>

  <section aria-label="Featured project" class="section reveal">
    <h2 class="sectionTitle">Featured project.</h2>
    <a href={featured.href} class="featuredCard">
      <figure class="featuredThumb">
        <img
          src={featured.thumbnail}
          data-fallback={featured.fallbackThumbnail}
          alt=""
          loading="lazy"
          decoding="async"
          onerror="if(this.dataset.fallback && this.src !== new URL(this.dataset.fallback, location.href).href){this.src=this.dataset.fallback}else{this.onerror=null}"
        />
      </figure>
      <div class="featuredBody">
        <p class="featuredCategory">{featured.category}</p>
        <h2 class="featuredTitle">{featured.title}</h2>
        <p class="featuredBlurb">{featured.blurb}</p>
        <span class="featuredCta">Read the project →</span>
      </div>
    </a>
  </section>

  <section aria-label="Fascinations" class="section reveal">
    <h2 class="sectionTitle">Fascinations.</h2>
    <ul class="list">
      <li><strong>Molecular biology</strong>, nature’s engineering magnum opus, humbling and inspiring human ingenuity.</li>
      <li><strong>Engineering</strong>, finely tuned systems to ease daily burdens and contend with the power of nature.</li>
      <li><strong>Encounter and travel</strong>, immersion in raw humanity as the shortest path through the ache of becoming.</li>
      <li><strong>Horses</strong>, mirrors of doubt and trust, bold companions in toil and play, reminding us to husband creation tenderly.</li>
      <li><strong>History</strong>, people and places, rules and dissent, where the agency of a few colours the human story.</li>
      <li><strong>Oil painting</strong>, deconstructing perception through line, form, and value to command light, shadow, and flesh.</li>
    </ul>
  </section>

  <section aria-label="Contact" class="section reveal">
    <h2 class="sectionTitle">Contact.</h2>

    <details class="contactDetails">
      <summary class="muted">
        Reach me <span class="link contactTrigger">here</span>. Remember to check out my
        <a href="/projects" class="link">projects</a>.
      </summary>

      <div class="contactFormWrap">
        <iframe
          src="https://docs.google.com/forms/d/e/1FAIpQLSd3lH0PrHPzpOygdmESCbDNpH0ovIOK73aIArv2PAQWTTbncg/viewform?embedded=true"
          width="100%"
          height="720"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          loading="lazy"
          title="Contact form"
        >
          Loading…
        </iframe>
      </div>
    </details>
  </section>

  <style>
    .contentNarrow {
      max-width: 720px;
      width: 100%;
      margin: 0 auto;
    }

    .heroImage {
      margin: 0 auto;
      width: 100%;
      max-width: 520px;
      overflow: hidden;
      border-radius: 16px;
    }

    .heroImage img {
      display: block;
      width: 100%;
      height: auto;
    }

    .featuredCard {
      display: grid;
      grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
      gap: 1.25rem;
      align-items: stretch;
      padding: 1rem;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--bg-elevated);
      text-decoration: none;
      color: inherit;
      transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
    }

    .featuredCard:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
    }

    html[data-theme="dark"] .featuredCard:hover {
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
    }

    .featuredThumb {
      margin: 0;
      overflow: hidden;
      border-radius: 10px;
      aspect-ratio: 4 / 3;
      background: rgba(0, 0, 0, 0.04);
    }

    .featuredThumb img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .featuredBody {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .featuredCategory {
      margin: 0 0 0.35rem;
      font-size: var(--font-size-xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .featuredTitle {
      margin: 0 0 0.5rem;
      font-family: var(--font-serif);
      font-size: var(--font-size-xl);
      line-height: var(--leading-tight);
      color: var(--text);
    }

    .featuredBlurb {
      margin: 0 0 0.85rem;
      flex: 1;
    }

    .featuredCta {
      font-size: var(--font-size-sm);
      color: var(--accent);
    }

    @media (max-width: 640px) {
      .featuredCard {
        grid-template-columns: 1fr;
      }

      .featuredThumb {
        max-height: 200px;
      }
    }

    .sectionTitle {
      color: #8a3a3a;
    }

    :global(html.dark) .sectionTitle,
    :global(html.night) .sectionTitle,
    :global(html[data-theme="dark"]) .sectionTitle,
    :global(html[data-theme="night"]) .sectionTitle,
    :global(body.dark) .sectionTitle,
    :global(body.night) .sectionTitle,
    :global(body[data-theme="dark"]) .sectionTitle,
    :global(body[data-theme="night"]) .sectionTitle {
      color: #8b7a4a;
    }

    @media (prefers-color-scheme: dark) {
      .sectionTitle {
        color: #8b7a4a;
      }
    }
  </style>
</Layout>
